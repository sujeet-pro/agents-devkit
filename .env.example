# ─────────────────────────────────────────────────────────────────────────────
# agents-devkit — MCP server credentials
#
# These are the env vars that plugins/adk/.mcp.json interpolates (${VAR}).
# The source of truth is ~/.zshenv: copy the lines you need into it and fill in
# real values. This file is committed documentation ONLY — do not put secrets
# here. Validate with:   scripts/creds/validate.py
#
# Naming: vars consumed directly by .mcp.json have plain names. Vars suffixed
# _CRED are used only by the rotation/login machinery (Slack), never by .mcp.json.
# Placeholders below (ADD_VALUE / <...>) are treated as "unset" by validate.py.
# ─────────────────────────────────────────────────────────────────────────────

# Live (gitignored) creds dir. Rendered config files (e.g. Snowflake's
# connections.toml) land here via `scripts/creds/init.py`. Point this at the
# repo's .creds/ so generated configs stay out of ~/.config and out of git.
export ADK_CREDS_DIR="/path/to/agents-devkit/.creds"

# datadog — Organization Settings → API Keys / Application Keys
#   https://app.datadoghq.com/organization-settings/api-keys
export DATADOG_API_KEY=ADD_VALUE
export DATADOG_APP_KEY=ADD_VALUE
# export DATADOG_SITE=datadoghq.com        # override for EU/other sites

# atlassian — API token: https://id.atlassian.com/manage-profile/security/api-tokens
export CONFLUENCE_URL="https://your-site.atlassian.net/wiki"   # note the /wiki suffix
export JIRA_URL="https://your-site.atlassian.net"
export ATLASSIAN_USERNAME="you@example.com"
export ATLASSIAN_API_TOKEN=ADD_VALUE

# slack — tokens consumed by .mcp.json (minted via OAuth: scripts/creds/login.py slack)
export SLACK_BOT_TOKEN=ADD_VALUE     # xoxb-...
export SLACK_USER_TOKEN=ADD_VALUE    # xoxp-...
# slack — app-config (used only for `scripts/creds/rotate.py slack`)
#   App Basic Information + https://api.slack.com/authentication/config-tokens
export SLACK_APP_ID=ADD_VALUE
export SLACK_CLIENT_ID=ADD_VALUE
export SLACK_CREDENTIALS_FILE="$ADK_CREDS_DIR/slack/slack.token.json"
export SLACK_CLIENT_SECRET_CRED=ADD_VALUE
export SLACK_APP_CONFIG_ACCESS_TOKEN_CRED=ADD_VALUE
export SLACK_APP_CONFIG_REFRESH_TOKEN_CRED=ADD_VALUE

# statsig — read-only Console API key: https://console.statsig.com/api_keys
export STATSIG_CONSOLE_API_KEY_RO=ADD_VALUE

# mixpanel — hosted OAuth, no key. Authenticate from your MCP client.

# snowflake — short-lived access token; re-mint via Snowsight / `snow` CLI.
#   connections.toml + service-config.yaml are GENERATED from the connection
#   metadata below by `scripts/creds/init.py` (do not hand-edit the live files).
export SNOWFLAKE_CONNECTION_NAME=adk
export SNOWFLAKE_HOME="$ADK_CREDS_DIR/snowflake"
export SNOWFLAKE_ACCESS_TOKEN=ADD_VALUE
export SNOWFLAKE_SERVICE_CONFIG_FILE="$ADK_CREDS_DIR/snowflake/service-config.yaml"
# connection metadata (rendered into connections.toml; the token is passed via
# --password by .mcp.json, so it is NOT stored in the file).
export SNOWFLAKE_ACCOUNT="<ORG-ACCOUNT>"               # Snowsight → Account → locator
export SNOWFLAKE_USER="you@example.com"
export SNOWFLAKE_AUTHENTICATOR="snowflake"               # PAT goes in --password
export SNOWFLAKE_ROLE="<ROLE>"
export SNOWFLAKE_WAREHOUSE="<WAREHOUSE>"
export SNOWFLAKE_DATABASE="<DATABASE>"
export SNOWFLAKE_SCHEMA="<SCHEMA>"

# looker — Admin → Users → Edit Keys (API3 client id/secret)
export LOOKER_BASE_URL="https://your.cloud.looker.com"
export LOOKER_CLIENT_ID=ADD_VALUE
export LOOKER_CLIENT_SECRET=ADD_VALUE

# google (workspace-mcp) — OAuth client from console.cloud.google.com; the
#   per-user grant is completed in a browser on first MCP use and cached in
#   GOOGLE_WORKSPACE_MCP_CREDENTIALS_DIR.
export GOOGLE_CLIENT_ID=ADD_VALUE
export GOOGLE_CLIENT_SECRET=ADD_VALUE
export USER_GOOGLE_EMAIL="you@example.com"
export GOOGLE_WORKSPACE_MCP_CREDENTIALS_DIR="$ADK_CREDS_DIR/google-mcp"
