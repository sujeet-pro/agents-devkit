// pr-reviews-slack.json5 — slack-side config for /adk-pr-reviews
//
// Default location: ~/.agents-devkit/config/pr-reviews-slack.json5
// On --scan, the script reads this to know which channels to scan, what counts
// as a PR URL, which users to filter by, and which emoji to react with per status.
//
// All keys are optional UNLESS marked required. The script logs which defaults it
// fell back to so you can see what's missing.
{
  // REQUIRED. Slack channels to scan. Either channel IDs (start with C / G) or
  // human names (start with #). Names get resolved to IDs once and cached.
  channels: [
    // "#eng-reviews",
    // "C0123456789",
  ],

  // REQUIRED. URL prefixes that identify a PR. The scanner matches any URL in a
  // message that STARTS WITH any of these prefixes (case-insensitive). Narrow
  // down to your orgs if you want — empty list = no PRs detected.
  url_patterns: [
    "https://github.com/",
    "https://bitbucket.org/",
  ],

  // Status → emoji name (no colons). null = don't react for this status.
  // On normal transitions the prior reaction (last_reaction_status) is removed
  // and the new one added. On a transition INTO `approved` or `merged`, the bot
  // sweeps ALL OTHER configured status emojis off the message — so when a PR
  // goes from `comments` → `approved` (or `→ merged`), the prior change-requested
  // / in-review emojis are removed and only the final one remains.
  status_emoji: {
    pending:    null,
    in_review:  "eyes",
    reviewed:   "white_check_mark",     // reviewed clean (no host approval yet)
    comments:   "warning",              // has open review comments / findings
    needs_fix:  "warning",              // back-compat alias of `comments`
    approved:   "heavy_check_mark",     // host APPROVED OR recommendation:approve
    merged:     "tada",
    error:      "x",
    reminded:   "bell",
  },

  // User filter — only consider PRs where AT LEAST ONE of these users is
  // mentioned in the main message OR ANY reply in the thread. Empty list ([]) /
  // omitted = no filter (every PR-link message counts).
  //
  // Use Slack user IDs (Uxxxxxxx) or @display-names — the script resolves names
  // to IDs at scan time.
  filter_mentioned_users: [
    // "@sujeet",
  ],

  // Days back to scan when --since is not given on the CLI.
  scan_days_default: 14,

  // Reminder policy. When a PR was last reviewed > after_hours ago AND its
  // head_oid hasn't changed AND it has open findings (re_review_required==true)
  // AND it has a slack_link → the batch posts a reply tagging the configured
  // users.
  reminder: {
    enabled: true,
    after_hours: 24,

    // Who to @-tag in the reminder. Recognised tokens:
    //  - "author"          → the PR author (from gh/bb metadata)
    //  - "thread_starter"  → the slack user who started the thread
    //  - "@<name>"         → literal user
    //  - "U..."            → literal slack user ID
    tag_users: ["author", "thread_starter"],

    // Template — {author}, {thread_starter}, {pr_link}, {pending_findings} are
    // substituted. Use Slack mention syntax `<@U…>` (the script wraps tag_users
    // tokens into mentions automatically).
    message_template:
      "PR review pending — please address the {pending_findings} open comments above. cc {author} {thread_starter}",

    // Cap to avoid spamming. Per-PR, the script will not send another reminder
    // within this window.
    min_hours_between_reminders: 24,
  },

  // Cache of channel-name → channel-id resolutions. The script writes this back
  // after each scan; you can edit but don't have to.
  channel_id_cache: {
    // "#eng-reviews": "C0123456789",
  },
}
