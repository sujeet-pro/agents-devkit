{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "adk-pr-review finding set",
  "type": "object",
  "additionalProperties": false,
  "required": ["findings", "existing_comment_actions", "recommendation", "summary", "finding_set_hash"],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "dimension", "severity", "confidence", "file", "line_start", "line_end", "body", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^f-\\d{3,}$" },
          "title": { "type": "string", "maxLength": 80 },
          "dimension": {
            "type": "string",
            "enum": [
              "correctness",
              "security",
              "performance",
              "tests",
              "docs",
              "api",
              "observability",
              "concurrency",
              "feature-flow",
              "style",
              "pre-merge-sanity"
            ]
          },
          "severity": {
            "type": "string",
            "enum": ["blocker", "critical", "should-have", "may-have", "nitpick", "question", "appreciation"]
          },
          "confidence": { "type": "string", "enum": ["high", "med", "low"] },
          "file": { "type": "string" },
          "line_start": { "type": "integer", "minimum": 1 },
          "line_end": { "type": "integer", "minimum": 1 },
          "body": { "type": "string", "maxLength": 1500 },
          "suggestion": { "type": "string", "maxLength": 1500 },
          "impact_if_unfixed": { "type": "string", "maxLength": 300 },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "ref"],
              "properties": {
                "kind": { "type": "string", "enum": ["diff", "code", "doc", "symbol", "feature-flag", "experiment", "config", "test"] },
                "ref": { "type": "string" },
                "state": { "type": "string", "enum": ["rolled-out", "partial", "off", "unknown"] }
              }
            }
          }
        }
      }
    },
    "existing_comment_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["comment_id", "decision", "reason"],
        "properties": {
          "comment_id": { "type": "string" },
          "decision": { "type": "string", "enum": ["resolve", "reopen", "leave-as-is"] },
          "reason": { "type": "string", "maxLength": 200 },
          "evidence_ref": { "type": "string" },
          "offline_alignment_detected": { "type": "boolean" }
        }
      }
    },
    "recommendation": {
      "type": "string",
      "enum": ["approve", "request_changes", "comment_only"]
    },
    "summary": { "type": "string", "maxLength": 600 },
    "finding_set_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
