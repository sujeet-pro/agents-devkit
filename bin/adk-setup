#!/usr/bin/env node
/**
 * adk-setup
 *
 * Macros for the `setup` skill. Verifies and installs required CLI tools via Homebrew,
 * checks env vars referenced by .mcp.json against ~/.zshenv, then delegates MCP install
 * to bin/adk-mcp-install.
 *
 * macOS only.
 *
 * Usage:
 *   bin/adk-setup                # interactive
 *   bin/adk-setup --auto         # install missing without asking; no MCP step
 *   bin/adk-setup --target cli      # only CLI tools
 *   bin/adk-setup --target mcp      # only MCP step
 *   bin/adk-setup --target memory   # only the user-memory wiring step
 *   bin/adk-setup --target all      # cli + mcp + memory (default)
 *   bin/adk-setup --skip-memory     # cli + mcp, skip the memory step
 */

import { execSync, spawnSync } from "node:child_process";
import { existsSync, readFileSync } from "node:fs";
import { homedir, platform } from "node:os";
import { resolve, dirname } from "node:path";
import { fileURLToPath } from "node:url";

const __filename = fileURLToPath(import.meta.url);
const PLUGIN_ROOT = resolve(dirname(__filename), "..");

const args = process.argv.slice(2);
const has = (k) => args.includes(k);
const get = (k) => { const i = args.indexOf(k); return i >= 0 ? args[i + 1] : null; };
const AUTO = has("--auto");
const TARGET = get("--target") || "all";
const SKIP_MEMORY = has("--skip-memory");

if (platform() !== "darwin") {
  console.error("adk-setup: macOS only. Aborting.");
  process.exit(2);
}

const TOOLS = [
  { name: "brew",     check: ["which", "brew"],    install: null,                     reason: "Homebrew (install manually first)" },
  { name: "gh",       check: ["which", "gh"],      install: ["brew", "install", "gh"],          reason: "GitHub CLI" },
  { name: "jq",       check: ["which", "jq"],      install: ["brew", "install", "jq"],          reason: "JSON parser" },
  { name: "fd",       check: ["which", "fd"],      install: ["brew", "install", "fd"],          reason: "Fast file finder" },
  { name: "ripgrep",  check: ["which", "rg"],      install: ["brew", "install", "ripgrep"],     reason: "Fast grep" },
  { name: "fzf",      check: ["which", "fzf"],     install: ["brew", "install", "fzf"],         reason: "Fuzzy finder" },
  { name: "claude",   check: ["which", "claude"],  install: ["brew", "install", "--cask", "claude-code"], reason: "Claude Code CLI" },
  { name: "node",     check: ["node", "--version"],install: ["brew", "install", "node"],        reason: "Node.js >= 18" },
];

function present(check) {
  const r = spawnSync(check[0], check.slice(1), { stdio: "pipe" });
  return r.status === 0;
}

function tryInstall(tool) {
  if (!tool.install) {
    console.error(`  ${tool.name}: cannot auto-install. ${tool.reason}.`);
    return false;
  }
  console.log(`  ${tool.name}: installing via ${tool.install.join(" ")} ...`);
  const r = spawnSync(tool.install[0], tool.install.slice(1), { stdio: "inherit" });
  return r.status === 0;
}

if (TARGET === "all" || TARGET === "cli") {
  console.log("[adk-setup] CLI tools:");
  for (const t of TOOLS) {
    if (present(t.check)) { console.log(`  ${t.name}: present`); continue; }
    if (AUTO) {
      tryInstall(t);
    } else {
      console.log(`  ${t.name}: MISSING (${t.reason})`);
      console.log(`    Run with --auto to install, or manually: ${t.install ? t.install.join(" ") : "(see ${t.reason})"}`);
    }
  }

  // gh auth status
  const auth = spawnSync("gh", ["auth", "status"], { stdio: "pipe" });
  if (auth.status === 0) console.log("  gh: authed");
  else console.log("  gh: NOT authed. Run: gh auth login");
}

if (TARGET === "all" || TARGET === "mcp") {
  console.log("\n[adk-setup] MCP servers:");
  const cmd = AUTO ? ["node", "bin/adk-mcp-install", "--auto"] : ["node", "bin/adk-mcp-install"];
  spawnSync(cmd[0], cmd.slice(1), { stdio: "inherit", cwd: PLUGIN_ROOT });
}

if ((TARGET === "all" || TARGET === "memory") && !SKIP_MEMORY) {
  console.log("\n[adk-setup] User memory (CLAUDE.md / AGENTS.md per harness):");
  const cmd = ["node", "bin/adk-update-memory", "--plugin-root", PLUGIN_ROOT];
  spawnSync(cmd[0], cmd.slice(1), { stdio: "inherit", cwd: PLUGIN_ROOT });
}

console.log("\n[adk-setup] Done. Run `node bin/adk-doctor` to verify.");
