#!/usr/bin/env node
/**
 * adk-doctor
 *
 * Health check. Reports presence of required CLI tools, gh auth status,
 * MCP server registrations (via `claude mcp ls`), env vars referenced by
 * .mcp.json, and the result of `bin/adk-validate`.
 */

import { spawnSync } from "node:child_process";
import { existsSync, readFileSync } from "node:fs";
import { homedir, platform } from "node:os";
import { resolve, dirname } from "node:path";
import { fileURLToPath } from "node:url";

const __filename = fileURLToPath(import.meta.url);
const PLUGIN_ROOT = resolve(dirname(__filename), "..");

const TOOLS = ["brew", "gh", "jq", "fd", "rg", "fzf", "claude", "node", "docker"];

function check(name, check) {
  const r = spawnSync(check[0], check.slice(1), { stdio: "pipe" });
  return { name, present: r.status === 0, version: r.status === 0 ? r.stdout?.toString().split(/\r?\n/)[0]?.trim() : "" };
}

let warnings = 0, errors = 0;
console.log(`[adk-doctor] platform=${platform()}`);

console.log("\nCLI tools:");
for (const t of TOOLS) {
  const r = check(t, [t, "--version"]);
  if (r.present) console.log(`  ${t.padEnd(8)} ${r.version}`);
  else { console.log(`  ${t.padEnd(8)} MISSING`); if (t === "docker" || t === "fzf") warnings++; else errors++; }
}

const auth = spawnSync("gh", ["auth", "status"], { stdio: "pipe" });
console.log(`\ngh: ${auth.status === 0 ? "authed" : "NOT authed"}`);
if (auth.status !== 0) errors++;

const mcpFile = resolve(PLUGIN_ROOT, ".mcp.json");
if (existsSync(mcpFile)) {
  const mcp = JSON.parse(readFileSync(mcpFile, "utf8"));
  const allRefs = new Set();
  for (const s of Object.values(mcp.mcpServers || {})) {
    for (const m of JSON.stringify(s).matchAll(/\$\{([A-Z_][A-Z0-9_]*)\}/g)) allRefs.add(m[1]);
  }
  const zshenv = resolve(homedir(), ".zshenv");
  const env = {};
  if (existsSync(zshenv)) {
    const c = readFileSync(zshenv, "utf8");
    for (const m of c.matchAll(/^\s*export\s+([A-Z_][A-Z0-9_]*)\s*=/gm)) env[m[1]] = true;
  }
  console.log(`\nEnv vars referenced by .mcp.json:`);
  for (const v of [...allRefs].sort()) {
    const here = (v in env) || (v in process.env);
    console.log(`  ${v.padEnd(35)} ${here ? "present" : "MISSING (in ~/.zshenv)"}`);
    if (!here) warnings++;
  }
}

const mcpls = spawnSync("claude", ["mcp", "ls"], { stdio: "pipe" });
if (mcpls.status === 0) {
  console.log("\nclaude mcp ls:");
  process.stdout.write(mcpls.stdout);
} else {
  console.log("\nclaude mcp ls: not run (claude CLI missing or unavailable)");
}

const validate = spawnSync("node", ["bin/adk-validate"], { stdio: "pipe", cwd: PLUGIN_ROOT });
console.log("\nadk-validate:");
process.stdout.write(validate.stdout);
if (validate.status !== 0) errors++;

console.log(`\n[adk-doctor] ${warnings} warnings, ${errors} errors`);
process.exit(errors > 0 ? 1 : 0);
