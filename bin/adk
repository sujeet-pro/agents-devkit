#!/usr/bin/env python3
"""adk — agents-devkit CLI.

Dispatches subcommands to skills/adk-cli/scripts/. This script is symlinked
into ~/.local/bin/adk by install.py; Path(__file__).resolve() follows the
symlink back to the repo so subcommand modules are importable.

Subcommands:
  pr-sync       one-stop: scan + metadata refresh + drop merged + clean orphans + prepare
  pr-scan       scan Slack channels for PR links → upsert into the queue
  pr-queue      inspect / manage the queue (list, show, add, update, clean, …)
  pr-task       manage per-PR task folders (prepare, info, list, clean-orphans)
  repo          clone + index a repo (`repo add`) or pull + reindex (`repo update`)
  doctor        validate env, deps, MCPs, ollama server, slack token presence
  completion    emit a shell-completion script (bash | zsh | fish)

Every subcommand accepts `-y` / `--yes` for non-interactive mode (smart defaults,
no prompts). Skills shell out with `-y` for headless automation.

Run `adk <subcmd> --help` for per-subcommand options.
"""
from __future__ import annotations

import sys
from pathlib import Path

# Follow symlinks back to the repo so we can import the CLI modules.
THIS = Path(__file__).resolve()
REPO_ROOT = THIS.parent.parent  # <repo>/bin/adk → <repo>/
CLI_SCRIPTS = REPO_ROOT / "skills" / "adk-cli" / "scripts"
if not CLI_SCRIPTS.exists():
    sys.stderr.write(
        f"adk: cannot find {CLI_SCRIPTS}. Is the bin/adk symlink intact and the "
        "agents-devkit repo present at its install location?\n"
    )
    sys.exit(2)
sys.path.insert(0, str(CLI_SCRIPTS))


USAGE = """\
adk — agents-devkit CLI

Usage:
  adk pr-sync [--no-scan] [--no-clean-orphans] [--no-remind] [--no-prepare] [--dry-run]
                                              one-stop sync: scan → refresh → drop merged/closed →
                                              clean orphans → remind stale reviews → prepare task folders
                                              (destructive steps are actual-by-default; --dry-run to preview)
  adk pr-scan [--channels c1,c2] [--since-hours N] [--dry-run] [-y]
                                              scan Slack for PR links → upsert into the queue
  adk pr-queue list [--status <s>] [--urls-only]   list queue entries
  adk pr-queue show <pr-url>                  show one entry as JSON
  adk pr-queue add <slack-url|pr-url|number>  single-shot upsert (slack permalink, PR URL, or
                                              bare PR number using core.yaml defaults.repo)
  adk pr-queue update <pr-url>                refresh row metadata (head_sha + merged/closed state)
  adk pr-queue update --all                   refresh every non-terminal row (metadata only)
  adk pr-queue clean [--all] [-y]             drop merged + closed rows (or everything with --all -y)
  adk pr-queue ready-to-merge                 approved PRs grouped by open-comment state
  adk pr-queue release <pr-url> [--status s]  clear `taken_at`; optionally set terminal status
  adk pr-queue claim <pr-url> [--force]       atomically set taken_at + status=in_review (v4 §6.v)
  adk pr-queue heartbeat <pr-url>             bump taken_at to now (call every ~5 min during long review)
  adk pr-queue set-status <pr-url> <status>   change status without releasing the lock
  adk pr-queue get-next [--no-validate]       claim + return the next eligible row (validates via origin API)
  adk pr-queue remind [--threshold-hours N] [--dry-run]
                                              Slack-thread reminders for stale reviews
  adk pr-task prepare <pr-url> [--rebuild]    Phase 1: create/refresh the task folder
  adk pr-task prepare --all                   Phase 1 for every non-merged queue row (short-circuits)
  adk pr-task validate <pr-url>               Phase 3: gate findings.json on anchor + suggested-fix
  adk pr-task triage <pr-url> [--init|--finalize|--mark|--default-state]
                                              Phase 4: walk findings accept/reject/edit
  adk pr-task post <pr-url> [--no-post|--use-mcp|--no-slack-summary|--no-approve]
                                              Phase 5: post inline comments + Slack reply
  adk pr-task report <pr-url> [--merge-if-approved]
                                              Phase 6: render findings.md + report.md + clickable links
  adk pr-task resolve-comments <pr-url>       walk prior PR comments → resolve/reopen/leave
  adk pr-task info <pr-url>                   task-folder state as JSON
  adk pr-task list [--names-only|--paths]     every task folder under ~/.agents-devkit/skill-pr-review/
  adk pr-task clean-orphans [--dry-run] [-y]  drop on-disk folders with no queue row
  adk repo add <git-url|https-url> [--name <n>] [-y]
                                              clone + index a repo's default branch. Accepts ssh
                                              (git@host:owner/repo) OR https (https://host/owner/repo)
                                              input — the actual clone always uses ssh.
  adk repo update <name> [--rebuild] [-y]     fetch + fast-forward + incremental reindex (skip if HEAD unchanged)
  adk repo update --all [--rebuild] [-y]      update every indexed repo (continues on failure)
  adk repo branch add <name> --branch X [--auto] [--auto-reason "..."]
                                              start tracking + index a branch
  adk repo branch remove <name> --branch X    drop the index for a branch
  adk repo branch list <name>                 show tracked branches + SHA + ts
  adk repo rebuild-index <name> [--branch X]  rebuild a branch's index from scratch (when its dir was deleted by hand)
  adk repo migrate [<name>]                   migrate legacy v3 layout to v4 (idempotent)
  adk repo list [--names-only]                list repos under ~/.agents-devkit/repos/
  adk auto [--max-reviews N] [--parallel N] [--agent X] [--exclude URL] [--no-sync]
           [--dry-run] [--quiet-hours WW-XX] [--max-cost-usd N] [--report-to-slack #ch]
                                              headless review: pr-sync + spawn agents on every eligible PR.
                                              Scheduler-friendly (cron, launchd). NEVER merges (constitution §I.3).
                                              --quiet-hours WW-XX refuses to spawn during the local-clock window.
                                              --max-cost-usd aborts when the per-agent estimate × eligible count exceeds.
                                              --report-to-slack posts a one-liner to the channel at the end.
  adk doctor [--tui] [--strict]               validate env, deps, MCPs, ollama, tokens
  adk completion bash|zsh|fish                emit a shell-completion script

Defaults: queue at ~/.agents-devkit/config/pr-queue.json5.
Global flag: -y / --yes — non-interactive (no prompts; smart defaults). Pass to any subcommand.
"""


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE)
        return 0
    cmd = argv[0]
    rest = argv[1:]
    if cmd == "pr-scan":
        from pr_scan import main as f  # type: ignore[import-not-found]
        return f(rest)
    if cmd == "pr-queue":
        from pr_queue import main as f  # type: ignore[import-not-found]
        return f(rest)
    if cmd == "repo":
        from repo import main as f  # type: ignore[import-not-found]
        return f(rest)
    if cmd == "pr-task":
        from pr_task import main as f  # type: ignore[import-not-found]
        return f(rest)
    if cmd == "pr-sync":
        from pr_sync import main as f  # type: ignore[import-not-found]
        return f(rest)
    if cmd == "doctor":
        from doctor import main as f  # type: ignore[import-not-found]
        return f(rest)
    if cmd == "completion":
        from completion import main as f  # type: ignore[import-not-found]
        return f(rest)
    if cmd == "auto":
        from auto_run import main as f  # type: ignore[import-not-found]
        return f(rest)
    sys.stderr.write(f"adk: unknown subcommand `{cmd}`.\n\n{USAGE}")
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
