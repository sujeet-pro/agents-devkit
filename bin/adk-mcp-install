#!/usr/bin/env node
/**
 * adk-mcp-install
 *
 * Read .mcp.json (the bundled MCP server registry), resolve ${ENV_VAR}
 * placeholders from ~/.zshenv, prompt the user for which servers to enable,
 * and run `claude mcp add ...` per accepted server.
 *
 * Usage:
 *   bin/adk-mcp-install            # interactive picker
 *   bin/adk-mcp-install --auto     # enable every server whose env vars are present
 *   bin/adk-mcp-install --list     # just print which servers are registrable
 *   bin/adk-mcp-install --dry-run  # show commands that would run
 */

import { readFileSync, existsSync } from "node:fs";
import { execSync, spawnSync } from "node:child_process";
import { homedir } from "node:os";
import { resolve, dirname } from "node:path";
import { fileURLToPath } from "node:url";

const __filename = fileURLToPath(import.meta.url);
const PLUGIN_ROOT = resolve(dirname(__filename), "..");
const MCP_FILE = resolve(PLUGIN_ROOT, ".mcp.json");
const ZSHENV = resolve(homedir(), ".zshenv");

const args = process.argv.slice(2);
const has = (k) => args.includes(k);
const AUTO = has("--auto");
const LIST = has("--list");
const DRY = has("--dry-run");

if (!existsSync(MCP_FILE)) {
  console.error(`adk-mcp-install: ${MCP_FILE} not found.`);
  process.exit(1);
}

const mcp = JSON.parse(readFileSync(MCP_FILE, "utf8"));
const servers = mcp.mcpServers || {};

// Read env vars from ~/.zshenv (best-effort: parse `export VAR="value"` lines)
const envFromZshenv = {};
if (existsSync(ZSHENV)) {
  const content = readFileSync(ZSHENV, "utf8");
  const lineRe = /^\s*export\s+([A-Z_][A-Z0-9_]*)\s*=\s*("([^"]*)"|'([^']*)'|([^#\n]+))/gm;
  let m;
  while ((m = lineRe.exec(content)) !== null) {
    envFromZshenv[m[1]] = (m[3] !== undefined) ? m[3] : (m[4] !== undefined ? m[4] : m[5].trim());
  }
}

function envVarsReferenced(server) {
  const all = JSON.stringify(server);
  const set = new Set();
  for (const m of all.matchAll(/\$\{([A-Z_][A-Z0-9_]*)\}/g)) set.add(m[1]);
  return [...set];
}

function checkVars(server) {
  const refs = envVarsReferenced(server);
  const missing = refs.filter((v) => !(v in envFromZshenv) && !(v in process.env));
  return { refs, missing };
}

const rows = [];
for (const [name, server] of Object.entries(servers)) {
  const { refs, missing } = checkVars(server);
  rows.push({ name, refs, missing, ready: missing.length === 0 });
}

console.log("adk-mcp-install — server registry status:");
console.log("name                  | env-vars                              | ready");
console.log("--------------------- | ------------------------------------- | -----");
for (const r of rows) {
  const ev = r.refs.length ? r.refs.join(",") : "(none)";
  const yn = r.ready ? "yes" : `no (missing: ${r.missing.join(",")})`;
  console.log(`${r.name.padEnd(22)} | ${ev.padEnd(38)} | ${yn}`);
}

if (LIST) process.exit(0);

const enable = [];
if (AUTO) {
  enable.push(...rows.filter((r) => r.ready).map((r) => r.name));
} else {
  // Simple stdin prompt: comma-separated list of server names to enable
  process.stdout.write("\nEnter comma-separated server names to enable (or 'ready' for all ready, or empty to skip): ");
  const input = readStdinSync().trim();
  if (input === "ready") enable.push(...rows.filter((r) => r.ready).map((r) => r.name));
  else if (input) enable.push(...input.split(",").map((s) => s.trim()).filter(Boolean));
}

if (!enable.length) {
  console.log("Nothing to enable. Done.");
  process.exit(0);
}

console.log(`\nEnabling: ${enable.join(", ")}`);
for (const name of enable) {
  const server = servers[name];
  if (!server) { console.warn(`  ${name}: unknown, skipping`); continue; }
  // Build claude mcp add command
  const cmd = ["claude", "mcp", "add", name, "--scope", "user"];
  if (server.command) cmd.push("--command", server.command);
  for (const arg of server.args || []) { cmd.push("--arg", arg); }
  for (const [k, v] of Object.entries(server.env || {})) {
    // Resolve ${VAR} from envFromZshenv / process.env
    const resolved = String(v).replace(/\$\{([A-Z_][A-Z0-9_]*)\}/g, (_, x) => envFromZshenv[x] ?? process.env[x] ?? "");
    if (resolved) cmd.push("--env", `${k}=${resolved}`);
  }
  const display = cmd.map((p) => p.includes(" ") ? `'${p}'` : p).join(" ");
  console.log(`  $ ${display}`);
  if (DRY) continue;
  try {
    execSync(display, { stdio: "inherit" });
  } catch (e) {
    console.error(`  ${name}: claude mcp add failed (${e.status}). Continuing.`);
  }
}

console.log("\nDone. Verify with: claude mcp ls");

function readStdinSync() {
  const fd = 0;
  let chunks = [];
  try {
    const r = spawnSync("cat", { stdio: ["inherit", "pipe", "pipe"] });
    return r.stdout?.toString() || "";
  } catch { return ""; }
}
