#!/usr/bin/env node
/**
 * adk-validate
 *
 * Structural + content validator for the adk Claude Code plugin. Runs on every
 * PR via the `validate` GitHub Actions job and locally via `npm run validate`.
 *
 * Checks:
 *   - .claude-plugin/plugin.json valid (name === "adk")
 *   - For every skills/<name>/:
 *       * SKILL.md present
 *       * frontmatter has `name` matching folder
 *       * frontmatter has `description`
 *       * references/interaction-contract.md exists and is byte-identical to bin/canonical/interaction-contract.md
 *       * references/how-it-works.md exists
 *       * references/modes.md exists
 *       * references/validator.md exists (or task-prefixed equivalent for migrated skills)
 *   - For every agents/<role>.md: frontmatter has `name` matching basename (no .md)
 *   - hooks/hooks.json parses
 *   - .mcp.json parses
 *   - settings.json parses
 *
 * Also re-emits skills-manifest.json from the live tree.
 *
 * Usage:
 *   bin/adk-validate              # report; exit 0 if OK, 1 if any error
 *   bin/adk-validate --strict     # also fail on warnings
 *   bin/adk-validate --fix        # propagate canonical files (run sync-contracts) before checking
 */

import { readdirSync, statSync, readFileSync, writeFileSync, existsSync } from "node:fs";
import { execSync } from "node:child_process";
import { join, resolve, dirname, basename } from "node:path";
import { fileURLToPath } from "node:url";

const __filename = fileURLToPath(import.meta.url);
const PLUGIN_ROOT = resolve(dirname(__filename), "..");
const SKILLS = join(PLUGIN_ROOT, "skills");
const AGENTS = join(PLUGIN_ROOT, "agents");
const CANONICAL = join(PLUGIN_ROOT, "bin", "canonical");

const args = process.argv.slice(2);
const STRICT = args.includes("--strict");
const FIX = args.includes("--fix");

let errors = [];
let warnings = [];

function E(msg) { errors.push(msg); }
function W(msg) { warnings.push(msg); }

function parseFrontmatter(src) {
  const m = src.match(/^---\n([\s\S]*?)\n---\n/);
  if (!m) return null;
  const fm = {};
  for (const line of m[1].split(/\r?\n/)) {
    const mm = line.match(/^([a-zA-Z_-]+):\s*(.*?)\s*$/);
    if (mm) fm[mm[1]] = mm[2].replace(/^"|"$/g, "");
  }
  return fm;
}

if (FIX) {
  console.log("--fix: running adk-sync-contracts first");
  execSync("node bin/adk-sync-contracts", { stdio: "inherit", cwd: PLUGIN_ROOT });
}

const pluginJson = join(PLUGIN_ROOT, ".claude-plugin", "plugin.json");
try {
  const pj = JSON.parse(readFileSync(pluginJson, "utf8"));
  if (pj.name !== "adk") E(`.claude-plugin/plugin.json: name should be "adk", got "${pj.name}"`);
  if (!pj.version) W(`.claude-plugin/plugin.json: missing version`);
} catch (e) {
  E(`.claude-plugin/plugin.json: ${e.message}`);
}

const canonicalFiles = existsSync(CANONICAL) ? readdirSync(CANONICAL).filter((f) => statSync(join(CANONICAL, f)).isFile()) : [];
const canonicalContent = {};
for (const f of canonicalFiles) {
  canonicalContent[f] = readFileSync(join(CANONICAL, f));
}

const skills = readdirSync(SKILLS).filter((n) => statSync(join(SKILLS, n)).isDirectory());
const manifest = {
  plugin: "adk",
  version: JSON.parse(readFileSync(pluginJson, "utf8")).version || "0.0.0",
  generated: new Date().toISOString().slice(0, 10),
  skills: [],
};

for (const skill of skills) {
  const sd = join(SKILLS, skill);
  const skillMd = join(sd, "SKILL.md");
  if (!existsSync(skillMd)) { E(`skills/${skill}/SKILL.md missing`); continue; }
  const src = readFileSync(skillMd, "utf8");
  const fm = parseFrontmatter(src);
  if (!fm) { E(`skills/${skill}/SKILL.md: missing or malformed YAML frontmatter`); continue; }
  if (fm.name !== skill) E(`skills/${skill}/SKILL.md: frontmatter name="${fm.name}" must equal folder "${skill}"`);
  if (!fm.description) E(`skills/${skill}/SKILL.md: missing description`);

  const refs = join(sd, "references");
  const refFiles = existsSync(refs) ? readdirSync(refs) : [];

  // Skills that ship with the ADK standard reference set must have all of these.
  // External skill packs (e.g., diagramkit wrappers) opt out via `metadata.external: true`.
  const isExternal = /metadata:\s*[\s\S]*?external:\s*true/.test(src);
  if (!isExternal) {
    if (!existsSync(refs)) {
      W(`skills/${skill}/references missing`);
    } else {
      const required = ["how-it-works.md", "modes.md", "interaction-contract.md"];
      for (const r of required) {
        if (!refFiles.includes(r)) W(`skills/${skill}/references/${r} missing`);
      }
      const hasValidator = refFiles.includes("validator.md") || refFiles.some((f) => f.endsWith("-validator.md"));
      if (!hasValidator) W(`skills/${skill}/references: no validator.md (bare or task-prefixed)`);
    }
  }

  if (canonicalContent["interaction-contract.md"] && refFiles.includes("interaction-contract.md")) {
    const cur = readFileSync(join(refs, "interaction-contract.md"));
    if (Buffer.compare(cur, canonicalContent["interaction-contract.md"]) !== 0) {
      E(`skills/${skill}/references/interaction-contract.md is out-of-sync with bin/canonical/. Run: node bin/adk-sync-contracts`);
    }
  }

  manifest.skills.push({
    name: skill,
    description: fm.description.replace(/\s+/g, " ").trim(),
    path: `skills/${skill}`,
    invocation: `/adk:${skill}`,
  });
}

if (existsSync(AGENTS)) {
  for (const f of readdirSync(AGENTS).filter((f) => f.endsWith(".md"))) {
    const src = readFileSync(join(AGENTS, f), "utf8");
    const fm = parseFrontmatter(src);
    if (!fm) { E(`agents/${f}: missing frontmatter`); continue; }
    const expected = basename(f, ".md");
    if (fm.name !== expected) E(`agents/${f}: name="${fm.name}" must equal "${expected}"`);
    if (!fm.description) E(`agents/${f}: missing description`);
  }
}

for (const [path, label] of [
  [join(PLUGIN_ROOT, "hooks", "hooks.json"), "hooks/hooks.json"],
  [join(PLUGIN_ROOT, ".mcp.json"), ".mcp.json"],
  [join(PLUGIN_ROOT, "settings.json"), "settings.json"],
]) {
  if (!existsSync(path)) { W(`${label} missing`); continue; }
  try { JSON.parse(readFileSync(path, "utf8")); } catch (e) { E(`${label}: invalid JSON: ${e.message}`); }
}

writeFileSync(join(PLUGIN_ROOT, "skills-manifest.json"), JSON.stringify(manifest, null, 2) + "\n");

console.log(`adk-validate: skills=${skills.length} errors=${errors.length} warnings=${warnings.length}`);
for (const e of errors) console.log(`  ERROR: ${e}`);
for (const w of warnings) console.log(`  WARN:  ${w}`);
console.log(`(skills-manifest.json regenerated)`);

if (errors.length > 0) process.exit(1);
if (STRICT && warnings.length > 0) process.exit(1);
process.exit(0);
