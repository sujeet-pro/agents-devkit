Screen {
    layout: vertical;
}

HeaderBar {
    dock: top;
    height: 1;
    background: $primary-background;
    color: $text;
    padding: 0 1;
}

FooterBar {
    dock: bottom;
    height: 1;
    background: $primary-background;
    color: $text;
    padding: 0 1;
}

#main {
    layout: horizontal;
    height: 1fr;
}

QueueTable {
    width: 3fr;
    height: 1fr;
}

QueueTable > .datatable--header {
    text-style: bold;
}

/* TabbedDetailPane is the mounted widget; DetailPane is its Overview sub-widget */
TabbedDetailPane {
    width: 1fr;
    height: 1fr;
    background: $surface;
}

TabbedDetailPane TabbedContent {
    height: 1fr;
}

TabbedDetailPane TabPane {
    padding: 0 1;
    height: 1fr;
}

/* Preserve the original DetailPane text style when used as Overview sub-widget */
TabbedDetailPane DetailPane {
    height: auto;
    padding: 0;
    background: $surface;
}

WorkersPane {
    height: auto;
    min-height: 1;
    max-height: 6;
    padding: 0 1;
    background: $boost;
}

RunsPane {
    height: auto;
    min-height: 1;
    max-height: 6;
    padding: 0 1;
    background: $boost;
}

SyncPlanPane {
    height: auto;
    min-height: 2;
    max-height: 8;
    padding: 0 1;
    background: $boost;
}

LogPane {
    height: 10;
    border-top: solid $primary;
    background: $surface;
}
