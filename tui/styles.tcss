Screen { layout: vertical; }

HeaderBar { dock: top; height: 1; background: $primary-background; color: $text; padding: 0 1; }
FooterBar { dock: bottom; height: 1; background: $primary-background; color: $text; padding: 0 1; }

/* #main is a vertical stack; QueueTable and TabbedDetailPane share the
   remaining height via fr units set at runtime in AdkApp._apply_layout.
   The four thin bars (QueueStatusBar, QueueActionBar, PRStatusBar,
   PRActionBar) and the SplitterHandle each take 1 natural row. */
#main { height: 1fr; width: 1fr; layout: vertical; }

QueueStatusBar {
    height: 1;
    width: 1fr;
    background: $primary-background;
    color: $text-muted;
    padding: 0 1;
}

QueueTable { height: 1fr; width: 1fr; }
QueueTable > .datatable--header { text-style: bold; }

QueueActionBar {
    height: 1;
    width: 1fr;
    background: $primary-background;
    color: $text-muted;
    padding: 0 1;
}

PRStatusBar {
    height: 1;
    width: 1fr;
    background: $surface;
    color: $text;
    padding: 0 1;
    text-style: bold;
}

TabbedDetailPane { height: 1fr; width: 1fr; background: $surface; }
TabbedDetailPane TabbedContent { height: 1fr; }
TabbedDetailPane TabPane { padding: 0 1; height: 1fr; }
TabbedDetailPane DetailPane { height: auto; padding: 0; background: $surface; }
TabbedDetailPane Markdown { height: auto; background: $surface; padding: 0 1; }
TabbedDetailPane MarkdownViewer { height: 1fr; background: $surface; }

/* Always reserve a visible scrollbar gutter on the tab content scrolls so
   the user can see the affordance + the scroll position at a glance. */
TabbedDetailPane VerticalScroll,
TabbedDetailPane ScrollableContainer {
    scrollbar-gutter: stable;
    scrollbar-size-vertical: 1;
    scrollbar-color: $accent;
    scrollbar-color-hover: $accent;
    scrollbar-color-active: $accent;
    scrollbar-background: $surface;
}

PRActionBar {
    height: 1;
    width: 1fr;
    background: $primary-background;
    color: $text-muted;
    padding: 0 1;
}

ActivityPane { height: 1fr; }
ActivityPane VerticalScroll { height: 1fr; }
ActivityPane Static { padding: 0 1; }
ActivityPane .activity-section-header { text-style: bold; padding-top: 1; color: $accent; }
ActivityPane #activity-log { background: $surface; }
