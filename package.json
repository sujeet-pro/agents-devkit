{
  "name": "agents-devkit",
  "version": "1.1.0",
  "description": "Agent Development Kit (ADK) - a Claude Code plugin shipping 50+ composable, self-contained, highly-interactive skills covering the full developer loop: discovery, brainstorm, requirements, scoping, planning, design, frontend, build, review, browser-based validation, docs, audits, publishing, CI/CD, and observability. Distributed as a Claude Code plugin via the marketplace at .claude-plugin/marketplace.json (GitHub source by default, npm source for semver-pinned installs).",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "claudePlugin": {
    "manifest": ".claude-plugin/plugin.json",
    "marketplace": ".claude-plugin/marketplace.json"
  },
  "files": [
    ".claude-plugin/",
    "skills/",
    "agents/",
    "hooks/",
    "monitors/",
    "bin/",
    ".mcp.json",
    "settings.json",
    "skills-manifest.json",
    "CLAUDE.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run docs:build",
    "preview": "npm run docs:preview",
    "validate": "node bin/adk-validate",
    "validate:sync": "node bin/adk-sync-contracts --check",
    "sync-contracts": "node bin/adk-sync-contracts",
    "skills:manifest": "node bin/internal/manifest.mjs",
    "docs:dev": "pagesmith-docs dev",
    "docs:build": "npm run docs:skills && pagesmith-docs build",
    "docs:preview": "pagesmith-docs preview",
    "docs:skills": "node bin/internal/generate-skill-docs.mjs"
  },
  "dependencies": {
    "@pagesmith/site": "^0.9.9",
    "diagramkit": "^0.3.3",
    "json5": "^2.2.3"
  },
  "devDependencies": {
    "@pagesmith/docs": "^0.9.4"
  },
  "keywords": [
    "claude-code",
    "claude-plugin",
    "agents",
    "skills",
    "ai",
    "mcp",
    "developer-tools",
    "code-review",
    "ci-cd",
    "browser-validation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sujeet-pro/agents-devkit.git"
  },
  "homepage": "https://github.com/sujeet-pro/agents-devkit#readme",
  "bugs": {
    "url": "https://github.com/sujeet-pro/agents-devkit/issues"
  },
  "license": "MIT"
}
