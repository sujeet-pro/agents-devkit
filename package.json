{
  "name": "claude-marketplace",
  "version": "2.0.0",
  "description": "adk Claude Code plugin marketplace docs and validation tooling.",
  "type": "module",
  "private": true,
  "scripts": {
    "docs:reference": "node scripts/generate-reference-docs.mjs",
    "docs:dev": "npm run docs:reference && pagesmith-docs dev",
    "docs:build": "npm run docs:reference && pagesmith-docs build",
    "docs:preview": "pagesmith-docs preview",
    "version:bump": "node scripts/bump-version.mjs",
    "validate": "node scripts/validate-marketplace.mjs && npm run docs:reference"
  },
  "devDependencies": {
    "@pagesmith/docs": "^0.10.0"
  }
}
