{
  "name": "agents-devkit",
  "version": "0.0.1",
  "description": "Agent Development Kit: 38 self-contained adk-* skills (each with its own flat references/, including a default-ask-with-explained-options interaction contract and an --auto unattended mode), independent per-provider custom subagents (Claude / Cursor / Codex), per-runtime hooks, MCP server configs, and global prompts. The Node CLI installs everything into Claude Code, Claude Desktop, Cursor, Codex CLI / Desktop, Gemini CLI, Antigravity, and Junie via a single .agents/skills hub.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "adk-install": "cli/index.mjs",
    "adk": "cli/index.mjs"
  },
  "files": [
    "cli/",
    "skills/",
    "agents-claude/",
    "agents-cursor/",
    "agents-codex/",
    "hooks/",
    "mcp-config/",
    "global-prompts/",
    "workflows/",
    "skills-manifest.json",
    "REFERENCE.md",
    "AGENTS.md",
    "CLAUDE.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "setup": "node cli/index.mjs",
    "setup:dry": "node cli/index.mjs --dry-run",
    "setup:auto": "node cli/index.mjs -y --force",
    "doctor": "node cli/index.mjs doctor",
    "postinstall": "node cli/postinstall.mjs",
    "validate": "node cli/lib/validate.mjs",
    "validate:content": "node cli/lib/validate-content.mjs",
    "validate:content:verbose": "node cli/lib/validate-content.mjs --verbose",
    "validate:all": "npm run validate && npm run validate:content",
    "build": "npm run docs:build",
    "preview": "npm run docs:preview",
    "docs:dev": "pagesmith-docs dev",
    "docs:build": "pagesmith-docs build",
    "docs:preview": "pagesmith-docs preview",
    "skills:manifest": "node cli/lib/manifest.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "json5": "^2.2.3"
  },
  "devDependencies": {
    "@pagesmith/docs": "^0.9.4"
  },
  "keywords": [
    "agents",
    "skills",
    "claude",
    "cursor",
    "codex",
    "ai",
    "mcp",
    "developer-tools",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sujeet-pro/agents-devkit.git"
  },
  "homepage": "https://github.com/sujeet-pro/agents-devkit#readme",
  "bugs": {
    "url": "https://github.com/sujeet-pro/agents-devkit/issues"
  },
  "license": "MIT"
}
