{
  "version": 4,
  "description": "Maps canonical ai-guidelines files to published adk-* skills. Run: python3 ai-guidelines/scripts/refresh_adk_skills.py copy-shared",
  "common": {
    "description": "Files copied to every published skill under references/_shared/",
    "mappings": [
      {
        "source": "ai-guidelines/README.md",
        "target": "references/_shared/ai-guidelines-overview.md"
      },
      {
        "source": "ai-guidelines/constitution.md",
        "target": "references/_shared/constitution.md"
      },
      {
        "source": "ai-guidelines/brainstorming-workflow.md",
        "target": "references/_shared/brainstorming-workflow.md"
      },
      {
        "source": "ai-guidelines/research-protocol.md",
        "target": "references/_shared/research-protocol.md"
      },
      {
        "source": "ai-guidelines/output-format.md",
        "target": "references/_shared/output-format.md"
      }
    ]
  },
  "selective": {
    "description": "Files copied to a subset of skills",
    "mappings": [
      {
        "source": "ai-guidelines/review-comment-format.md",
        "target": "references/review-comment-format.md",
        "skills": ["adk-review-pr", "adk-review-local-changes", "adk-review-docs", "adk-audit-repo", "adk-audit-site"]
      }
    ]
  },
  "project_surfaces": {
    "description": "Directories containing prj-* repo-maintenance skills that reference ai-guidelines/ directly",
    "paths": [".claude/skills", ".cursor/skills", ".agents/skills"]
  }
}
