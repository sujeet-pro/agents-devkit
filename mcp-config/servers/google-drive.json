{
  "command": "sh",
  "args": [
    "-c",
    "GOOGLE_DRIVE_OAUTH_CREDENTIALS=${GOOGLE_DRIVE_OAUTH_CREDENTIALS:-$HOME/.config/google-drive-mcp/gcp-oauth.keys.json} GOOGLE_DRIVE_MCP_TOKEN_PATH=${GOOGLE_DRIVE_MCP_TOKEN_PATH:-$HOME/.config/google-drive-mcp/tokens.json} npx -y @piotr-agier/google-drive-mcp"
  ],
  "env": {
    "GOOGLE_DRIVE_OAUTH_CREDENTIALS": "${GOOGLE_DRIVE_OAUTH_CREDENTIALS:-$HOME/.config/google-drive-mcp/gcp-oauth.keys.json}",
    "GOOGLE_DRIVE_MCP_TOKEN_PATH": "${GOOGLE_DRIVE_MCP_TOKEN_PATH:-$HOME/.config/google-drive-mcp/tokens.json}"
  },
  "description": "Google Drive MCP server. Uses OAuth credentials for authentication."
}
