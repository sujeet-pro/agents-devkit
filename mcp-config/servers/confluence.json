{
  "command": "sh",
  "args": [
    "-c",
    "uvx --with 'fakeredis<2.35' mcp-atlassian --confluence-url $CONFLUENCE_URL --confluence-username $CONFLUENCE_USERNAME --confluence-token $CONFLUENCE_API_TOKEN"
  ],
  "env": {
    "CONFLUENCE_URL": "${CONFLUENCE_URL}",
    "CONFLUENCE_USERNAME": "${CONFLUENCE_USERNAME}",
    "CONFLUENCE_API_TOKEN": "${CONFLUENCE_API_TOKEN}"
  },
  "description": "Atlassian Confluence MCP server. Requires Confluence URL and API credentials."
}
