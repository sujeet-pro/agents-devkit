%%{init: {'htmlLabels': false}}%%
flowchart TD
  A["Documentation intent"] --> B{"@adk:docs router\n-> direction?"}
  B -- "Author / update" --> D["@adk:docs-write\noutline -> draft -> validate -> markdown artifact"]
  B -- "Critique" --> E["@adk:docs-review\nread source + claim audit"]
  E --> S{"source type?"}
  S -- "Confluence (default: post)" --> P["inline + footer comments\non live page"]
  S -- "Local md / fetched URL" --> R["Markdown review file\n.temp/reports/"]
  P --> F{"--fix?"}
  R --> F
  F -- "yes (markdown only)" --> D
  F -- "no" --> G["review only\n(no edits)"]
