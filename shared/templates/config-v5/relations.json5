[
  // Cross-entity relationships. Entity keys: "<kind>:<id>".
  // Common kinds: repo, service, datadog.apm, statsig.project, mixpanel.project,
  //               snowflake.table, atlassian.confluence.space, atlassian.jira.project,
  //               github.repo, bitbucket.repo, slack.channel, dashboard.
  // Common relations: observed_by, observes, uses_flags_from, emits_events_to,
  //                   gates_feature, stored_in, documents, tracks.
  //
  // Example:
  // { from: "repo:my-service", to: "service:my-service",        relation: "observed_by" },
  // { from: "repo:my-service", to: "statsig.project:my-org",    relation: "uses_flags_from" },
  // { from: "repo:my-service", to: "mixpanel.project:12345",    relation: "emits_events_to" },
]
