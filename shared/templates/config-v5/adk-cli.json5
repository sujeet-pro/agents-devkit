// TEMPLATE — copy to $ADK_CONFIG_HOME/adk-cli.json5 and remove the keys you don't need to override.
// adk-cli.json5 — adk CLI behaviour knobs. Lives at $ADK_CONFIG_HOME/adk-cli.json5.
// All keys are optional; defaults are baked into the consumers.
// JSON5 format: comments are allowed, trailing commas are allowed.
{
  // `adk pr-sync` — Slack scan + queue refresh + merged-row cleanup + base-index audit.
  pr_sync: {
    // base-index promotion: minimum number of non-terminal queued PRs sharing
    // a target branch before audit auto-mode will `adk repo branch add --auto`
    // that branch. Default 2.
    base_index_promote_threshold: 2,

    // minimum age (hours) before a base index is eligible for drift-refresh.
    // Prevents re-embedding on every rapid merge to a shared branch. Default 1.0.
    base_index_refresh_min_age_hours: 1.0,

    // base-index audit mode when neither --dry-run nor -i are passed on the CLI.
    // Allowed values: "act" (default), "ask" (prompt per fix), "preview" (log only).
    // "off" is not a valid config value — use --no-base-audit on the CLI instead.
    audit_mode: "act",

    // number of parallel `adk pr-task prepare` workers during `adk pr-sync`'s
    // step 6 (prepare --all). Default 1.
    prepare_jobs: 1,

    // TTL in hours before an auto-promoted base index is eligible for
    // auto-demote cleanup (step 5.6). Default 24.0.
    auto_demote_ttl_hours: 24.0,
  },

  // `adk pr-review-all` — headless review orchestrator + pipelined scheduler.
  pr_review_all: {
    // global flag: false reverts to the legacy ThreadPoolExecutor path.
    // Default true.
    pr_pipeline_enabled: true,

    // per-stage semaphore counts. index_parallel=1 is the bottleneck by design
    // (LanceDB writes are single-writer). Raise import_parallel and
    // validate_parallel freely; they are IO-bound. Default values shown.
    import_parallel: 4,
    sync_parallel: 2,
    index_parallel: 1,
    validate_parallel: 4,
    post_parallel: 2,

    // number of concurrent agent review subprocesses (the review stage).
    // Follows --parallel on the CLI; no separate config key for review itself.
    // This key applies to the legacy ThreadPoolExecutor path only. Default 1.
    parallel: 1,

    // maximum PRs to review per orchestrator run. Default 20.
    max_reviews: 20,

    // agent runner interface. Allowed: "claude", "cursor", "codex", "custom".
    // Default "claude".
    runner: "claude",

    // override the runner binary path (used with runner="custom"). Default null
    // (uses the runner's built-in binary).
    agent: null,

    // model passed to runners that support explicit model selection.
    // "inherit" (default) omits --model and lets the harness choose.
    agent_model: "inherit",

    // automatically add --deep for large or high-risk PRs. Default true.
    auto_deep: true,

    // minimum changed-file count to trigger auto-deep. Default 20.
    auto_deep_file_threshold: 20,

    // minimum changed-line count (additions + deletions) to trigger auto-deep.
    // Default 800.
    auto_deep_line_threshold: 800,

    // refuse to spawn reviews inside this local-clock window. Format: "HH-HH"
    // (24h). Wrap-around supported: "22-06" means 22:00–06:00. Default null
    // (no quiet hours).
    quiet_hours: null,

    // abort the run if the pre-flight cost estimate (per-agent coefficient ×
    // eligible PR count) exceeds this amount in USD. Default null (no cap).
    max_cost_usd: null,

    // post a one-liner run summary to this Slack channel (e.g. "#pr-reviews")
    // after each orchestrator run. Requires SLACK_BOT_TOKEN_CRED. Default null.
    report_to_slack: null,
  },

  // `adk pr-queue add <bare-number>` defaults — resolves bare PR numbers like
  // `adk pr-queue add 1234` into full PR URLs.
  defaults: {
    // default repo in "<org>/<name>" form (e.g. "acme/storefront-bff").
    // Required for bare PR number resolution. Default null.
    repo: null,

    // forge platform for bare PR number resolution. Allowed: "github",
    // "bitbucket". Default "github".
    platform: "github",
  },

  // `adk pr` merge actions — guards against accidental API-driven merges.
  pr_actions: {
    // allow `adk pr merge` to merge via the forge API. Constitution §I.3
    // still applies: this flag enables the command path; a human must run it.
    // Default false.
    allow_api_merge: false,
  },
}
