{
  "_comment": "adk-managed permissions for Claude Code. Merged into ~/.claude/settings.json by install.py. Edit this file and re-run ./install.sh to refresh.",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "LS",
      "NotebookRead",
      "WebSearch",
      "WebFetch",
      "Edit",
      "Write",
      "MultiEdit",
      "NotebookEdit",
      "TodoWrite",
      "Task",
      "Bash",
      "mcp__*"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(sudo:*)",
      "Bash(git push:*)",
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git rebase:*)",
      "Bash(git restore:*)",
      "Bash(git revert:*)",
      "Bash(git checkout --:*)",
      "Bash(git stash drop:*)",
      "Bash(git branch -D:*)",
      "Bash(git tag -d:*)",
      "Bash(npm publish:*)",
      "Bash(yarn publish:*)",
      "Bash(pnpm publish:*)",
      "Bash(pip uninstall:*)",
      "Bash(brew uninstall:*)",
      "Bash(brew cleanup:*)",
      "Bash(docker system prune:*)",
      "Bash(docker volume rm:*)",
      "Bash(docker rmi:*)",
      "Bash(kubectl delete:*)",
      "Bash(kubectl apply:*)",
      "Bash(helm uninstall:*)",
      "Bash(helm upgrade:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(aws s3 rm:*)",
      "Bash(aws s3 sync:*)",
      "Bash(gcloud:* delete:*)",
      "Bash(shutdown:*)",
      "Bash(reboot:*)",
      "Bash(mkfs:*)",
      "Bash(dd:*)",
      "Bash(chmod -R:*)",
      "Bash(chown -R:*)"
    ],
    "deny": []
  }
}
