# adk v3 MCP servers — installed by ./install.sh --target codex
# Each block mirrors the corresponding JSON in {{ADK_REPO}}/mcp/.
# Edit {{ADK_REPO}}/mcp/adk-mcp-*.json and re-run install.sh to regenerate.

[[mcp_servers]]
name = "adk-mcp-github"
url = "https://api.githubcopilot.com/mcp/"
authorization_token_env = "GITHUB_TOKEN_CRED"

[[mcp_servers]]
name = "adk-mcp-datadog"
url = "https://mcp.datadoghq.com/api/unstable/mcp-server/mcp"

[[mcp_servers.headers]]
DD_API_KEY = "${DATADOG_API_KEY_CRED}"
DD_APPLICATION_KEY = "${DATADOG_APP_KEY_CRED}"

[[mcp_servers]]
name = "adk-mcp-statsig"
url = "https://api.statsig.com/v1/mcp"

[[mcp_servers.headers]]
"statsig-api-key" = "${STATSIG_CONSOLE_API_KEY_CRED}"

[[mcp_servers]]
name = "adk-mcp-atlassian"
command = "uvx"
args = ["mcp-atlassian@latest"]

[mcp_servers.env]
CONFLUENCE_URL = "https://${ATLASSIAN_SITE}/wiki"
CONFLUENCE_USERNAME = "${ATLASSIAN_USERNAME}"
CONFLUENCE_API_TOKEN = "${ATLASSIAN_API_TOKEN_CRED}"
JIRA_URL = "https://${ATLASSIAN_SITE}"
JIRA_USERNAME = "${ATLASSIAN_USERNAME}"
JIRA_API_TOKEN = "${ATLASSIAN_API_TOKEN_CRED}"

[[mcp_servers]]
name = "adk-mcp-mixpanel"
url = "https://mcp.mixpanel.com/mcp"

[[mcp_servers]]
name = "adk-mcp-slack"
command = "sh"
args = ["-c", "if [ -n \"$SLACK_CREDENTIALS_FILE\" ] && [ -r \"$SLACK_CREDENTIALS_FILE\" ]; then . \"$SLACK_CREDENTIALS_FILE\"; fi; exec npx -y slack-mcp-server@latest"]

[[mcp_servers]]
name = "adk-mcp-google"
command = "uvx"
args = ["workspace-mcp@latest"]

[mcp_servers.env]
GOOGLE_OAUTH_CLIENT_ID = "${GOOGLE_CLIENT_ID}"
GOOGLE_OAUTH_CLIENT_SECRET = "${GOOGLE_CLIENT_SECRET_CRED}"
USER_GOOGLE_EMAIL = "${USER_GOOGLE_EMAIL}"
WORKSPACE_MCP_CREDENTIALS_DIR = "${WORKSPACE_MCP_CREDENTIALS_DIR}"

[[mcp_servers]]
name = "adk-mcp-looker"
command = "uvx"
args = ["looker-mcp-server@latest", "--groups", "explore,query,schema,content"]

[mcp_servers.env]
LOOKER_BASE_URL = "${LOOKER_SITE}"
LOOKER_CLIENT_ID = "${LOOKER_CLIENT_ID}"
LOOKER_CLIENT_SECRET = "${LOOKER_CLIENT_SECRET_CRED}"
LOOKER_VERIFY_SSL = "${LOOKER_VERIFY_SSL}"

[[mcp_servers]]
name = "adk-mcp-snowflake"
command = "sh"
args = ["-c", "exec uvx snowflake-labs-mcp@latest --connection-name \"${SNOWFLAKE_CONNECTION_NAME:-adk}\" --password \"$SNOWFLAKE_ACCESS_TOKEN_CRED\" --service-config-file \"$SNOWFLAKE_SERVICE_CONFIG_FILE\""]

[mcp_servers.env]
SNOWFLAKE_HOME = "${SNOWFLAKE_HOME}"
SNOWFLAKE_CONNECTION_NAME = "${SNOWFLAKE_CONNECTION_NAME}"
SNOWFLAKE_SERVICE_CONFIG_FILE = "${SNOWFLAKE_SERVICE_CONFIG_FILE}"
SNOWFLAKE_ACCESS_TOKEN_CRED = "${SNOWFLAKE_ACCESS_TOKEN_CRED}"
